{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pulpo-api/pulpo/main/schemas/request.v1.schema.json",
  "title": "Pulpo request (version 1)",
  "description": "One request of a Pulpo collection, stored as <order>-<name>.pulpo.yaml. The body lives next to it in <order>-<name>.body.<ext>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "protocol", "url"],
  "properties": {
    "version": { "const": 1, "description": "File format version." },
    "name": { "type": "string", "minLength": 1, "description": "Name shown in the collection tree." },
    "protocol": {
      "enum": ["http", "graphql", "grpc", "websocket", "soap", "sse"],
      "description": "Protocol used to send the request."
    },
    "method": {
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
      "description": "HTTP method. Required when protocol is http."
    },
    "url": { "type": "string", "description": "Target URL with the enabled query params. May contain {{variables}} and :pathParams." },
    "pathParams": {
      "type": "array",
      "description": "Values for the :name segments of the URL path. Values may contain {{variables}}.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "disabledParams": {
      "type": "array",
      "description": "Query params kept but not sent (not part of url).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "enabled": { "type": "boolean", "default": true, "description": "Disabled headers are kept but not sent." }
        }
      }
    },
    "auth": { "$ref": "#/$defs/auth" },
    "body": {
      "enum": ["json", "xml", "graphql", "text"],
      "description": "Kind of the body file next to this one (.body.json, .body.xml, .body.graphql or .body.txt)."
    },
    "timeoutMs": { "type": "integer", "minimum": 1, "description": "Request timeout in milliseconds (default 30000)." }
  },
  "if": { "properties": { "protocol": { "const": "http" } } },
  "then": { "required": ["method"] },
  "$defs": {
    "auth": {
      "description": "How the request authenticates. Missing = inherit from the folder (_folder.yaml) or workspace (pulpo.yaml), which use the same block. Use {{variables}} for secrets.",
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "additionalProperties": false, "properties": { "type": { "const": "none" } } },
        { "additionalProperties": false, "required": ["token"], "properties": { "type": { "const": "bearer" }, "token": { "type": "string" } } },
        { "additionalProperties": false, "required": ["username"], "properties": { "type": { "const": "basic" }, "username": { "type": "string" }, "password": { "type": "string" } } },
        { "additionalProperties": false, "required": ["key", "value"], "properties": { "type": { "const": "apiKey" }, "key": { "type": "string" }, "value": { "type": "string" }, "in": { "enum": ["header", "query"], "default": "header" } } }
      ]
    }
  }
}
